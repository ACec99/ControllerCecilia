# Copy this file to .env before running the tutorial:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# These are fixed, identical values for every participant on every OS —
# they match the BUILD_UID/BUILD_GID already baked into the image, so no
# host-specific detection (id -u / id -g, which don't exist on Windows) is
# ever needed.
UID=1000
GID=1000
TZ=Europe/Rome
ENABLE_VNC=false
